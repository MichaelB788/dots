// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "git_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left"
  },
  "disable_ai": true,
  "vim_mode": true,
  "wrap_guides": [80],
  "show_wrap_guides": true,
  "relative_line_numbers": "enabled",
  "tab_size": 2,
  "base_keymap": "Zed",
  "ui_font_size": 18,
  "buffer_font_size": 18,
  "format_on_save": "on",

  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "gutter": {
    "folds": false,
  },
  "scrollbar": {
    "show": "never",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
}
