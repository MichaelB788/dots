{
  "cli_default_open_behavior": "existing_window",
  "relative_line_numbers": "enabled",
  "base_keymap": "Zed",
  "format_on_save": "on",
  "disable_ai": true,
  "vim_mode": true,
  "show_wrap_guides": true,
  "wrap_guides": [80],
  "tab_size": 2,
  "ui_font_size": 18,
  "buffer_font_size": 18,

  "project_panel": {
    "dock": "left"
  },

  "git_panel": {
    "dock": "left"
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },

  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  },

  "session": {
    "trust_all_worktrees": true
  },

  "gutter": {
    "folds": false
  },

  "scrollbar": {
    "show": "never"
  },

  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  }
}
